    <!-- MAC Address Input -->
    <EditText
        android:id="@+id/editTextMacAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Client ID"
        android:inputType="textCapCharacters" />

